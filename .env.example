# Local development database. For production remote/replica modes, replace this with
# the remote libSQL endpoint, for example libsql://your-database.turso.io.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Local embedded-replica file. Used by 'replica' mode (and 'local' mode if
# TURSO_DATABASE_URL is not a file: URL).
LOCAL_DB_PATH=file:local.db

# How to connect:
#   local   — file-only, no network
#   remote  — direct Turso (writes are immediate, reads incur RTT)
#   replica — embedded replica (web only; the worker stays on remote)
#
# In production these two keys live in infra/.env.cli-prod (gitignored,
# loaded only for local CLI invocations against prod) — kept out of
# infra/.env.production so that file uploads byte-identical to the
# server's /opt/playvow/shared/.env, where the systemd units supply
# DB_MODE per service via Environment= directives. For local dev (dev
# server, tests against your own DB), set them here in your gitignored
# .env.
DB_MODE=local

# Symmetric key used to encrypt SteamGifts cookies at rest. 32+ chars.
ENCRYPTION_KEY=demo-encryption-key-not-for-production-use

# https://steamcommunity.com/dev/apikey
STEAM_WEB_API_KEY=

# Origin URL used as openid.realm and base for the Steam sign-in callback.
# No path, no trailing slash. Must match the host the user actually visits.
# Local dev: http://localhost:3000. Prod: https://playvow.com.
STEAM_OPENID_REALM=http://localhost:3000

# Comma-separated SteamID64s that auto-receive the admin role on first
# Steam sign-in. Find yours at https://steamid.io/. Optional — sign-in
# works without it; only the auto-elevate-on-first-login behavior is gated.
# ADMIN_STEAM_IDS=

# Optional CF Worker (or any proxy) that re-issues SG requests from a
# non-blocked origin. Cloudflare gates some VPS IP ranges with a JS
# challenge; routing SG traffic through a CF Worker bypasses that since
# CF→CF traffic isn't WAF-challenged. Worker source: infra/cf-sg-proxy/.
# Leave both blank for direct SG calls (works in dev / clean IPs).
# SG_PROXY_BASE=https://playvow-sg-proxy.YOUR-SUBDOMAIN.workers.dev
# SG_PROXY_AUTH=match-the-worker-PROXY_SHARED_SECRET

# PostHog project API key (public, optional). Leave blank for local dev to
# disable analytics. Set in production to capture worker job metrics.
POSTHOG_API_KEY=

# PostHog browser key (public, optional). Distinct from POSTHOG_API_KEY:
# this one is bundled into the client build and exposed to every visitor.
# Use the same project as the server, or a separate browser-only project.
# Leave blank to disable client-side analytics. Starts with `phc_`.
VITE_PUBLIC_POSTHOG_KEY=

# Optional. Defaults to PostHog US ingest. Set explicitly for EU.
# VITE_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
