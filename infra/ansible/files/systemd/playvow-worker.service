[Unit]
Description=PlayVow worker (cron-driven scrape + playtime poll)
After=network-online.target playvow-web.service
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/playvow/shared
EnvironmentFile=/opt/playvow/shared/.env
# DB_MODE is set here (not in .env) so it doesn't conflict with the web
# unit's DB_MODE=replica override — see comment in infra/.env.production.
Environment=DB_MODE=remote
ExecStart=/opt/playvow/current/.output/node /opt/playvow/current/.output/server/worker.mjs
Restart=on-failure
RestartSec=5

# Memory caps for a 1GB VPS. Worker is smaller than web (no SSR, just cron
# jobs), so a tighter cap is fine. Higher OOMScoreAdjust than web means if
# the system runs out of memory the kernel picks the worker first — losing a
# scrape cycle is cheaper than losing the user-facing site.
MemoryHigh=150M
MemoryMax=192M
TasksMax=256
LimitNOFILE=4096
OOMScoreAdjust=700
OOMPolicy=stop

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
ReadWritePaths=/opt/playvow/shared

[Install]
WantedBy=multi-user.target
