# Template for infra/.env.production. Copy this file, fill in real values:
#   cp infra/.env.example infra/.env.production && $EDITOR infra/.env.production
#
# Used by:
#   - infra/deploy.sh — uploaded to /opt/playvow/shared/.env on every deploy
#   - ENV_FILE=infra/.env.production make {db-migrate,db-seed,scrape-once,...}
#
# Every key MUST have a real value in .env.production. The deploy preflight
# refuses to ship if anything is blank.

# Remote libSQL endpoint (Turso). The embedded replica syncs from here.
# Get with: turso db show playvow --url
TURSO_DATABASE_URL=libsql://playvow-<your-org>.turso.io

# Get with: turso db tokens create playvow
TURSO_AUTH_TOKEN=

# Local embedded-replica file. Only consumed when DB_MODE=replica. Use a
# different filename from the dev `local.db` so the two don't collide —
# libSQL won't accept a file that was created in local-only mode as an
# embedded replica.
LOCAL_DB_PATH=file:local-prod.db

# How to connect to Turso:
#   remote  — direct connection. Safe. Reads incur a network round-trip.
#   replica — embedded replica into LOCAL_DB_PATH. Faster reads, but local
#             writes currently race the background syncer at COMMIT.
#             Do not use until writes are split out to a remote client.
#   local   — file-only; not appropriate for production.
DB_MODE=remote

# Symmetric key used to encrypt SteamGifts cookies at rest. 32+ chars.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Multi-mod auth: JSON map of SteamGifts username → password.
# Each key must match a SteamGifts username; a DB user is auto-created on first login.
# Example: MOD_CREDENTIALS={"alice":"changeme","bob":"changeme"}
MOD_CREDENTIALS=

# https://steamcommunity.com/dev/apikey
STEAM_WEB_API_KEY=

# Origin used as openid.realm and base for /auth/steam/callback. Must match
# the host the user actually visits — Steam validates that return_to lives
# under realm. No path, no trailing slash. Example: https://playvow.com
STEAM_OPENID_REALM=

# Comma-separated SteamID64s that auto-receive the admin role on first
# Steam sign-in. Find yours at https://steamid.io/.
ADMIN_STEAM_IDS=

# Optional CF Worker proxy for SG. Cloudflare gates some VPS IP ranges
# with a JS challenge ("Just a moment..."); routing SG calls through a
# CF Worker uses CF's own infrastructure to bypass that. Worker source:
# infra/cf-sg-proxy/. Leave blank for direct SG calls.
# SG_PROXY_BASE=https://playvow-sg-proxy.YOUR-SUBDOMAIN.workers.dev
# SG_PROXY_AUTH=match-the-worker-PROXY_SHARED_SECRET

# PostHog project API key (public — safe to commit; can only send events).
# Find at https://us.posthog.com → Project Settings → Project API Key.
# Optional: leave blank to disable analytics (no-op fallback).
# POSTHOG_HOST defaults to https://us.i.posthog.com; set to EU host if needed.
POSTHOG_API_KEY=
# POSTHOG_HOST=

# PostHog browser key. Read by Vite at build time (deploy.sh passes this
# file via --env-file to `bun run build`) and inlined into the client JS
# bundle. Use the same project as POSTHOG_API_KEY or a separate browser
# project. Leave blank to disable client-side analytics. Starts with `phc_`.
VITE_PUBLIC_POSTHOG_KEY=

# Browser-side ingest host. Set to /ingest in production so requests go
# through Caddy's same-origin reverse proxy (defined in
# infra/ansible/files/caddy/Caddyfile) and bypass tracking-protection
# blockers. Leave unset for dev to hit PostHog's US ingest directly.
VITE_PUBLIC_POSTHOG_HOST=/ingest

NODE_ENV=production
