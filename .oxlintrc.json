{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error"
  },
  "settings": {
    "react": { "version": "19.2.0" }
  },
  "ignorePatterns": [
    "node_modules",
    ".output",
    ".tanstack",
    ".nitro",
    "src/routeTree.gen.ts",
    "src/db/migrations"
  ]
}
