{
  "name": "playvow",
  "private": true,
  "homepage": "https://github.com/Lexaire/PlayVow#readme",
  "bugs": {
    "url": "https://github.com/Lexaire/PlayVow/issues"
  },
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lexaire/PlayVow.git"
  },
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "TMPDIR=/tmp bun --bun vite dev --host 0.0.0.0 --port 3000",
    "setup:demo": "bun run db:migrate && bun run db:seed && bun run src/db/seed-fake.ts",
    "build": "bun run build:web && bun run build:worker && bun run build:vendor && bun run build:node",
    "build:web": "bun --bun vite build",
    "build:worker": "bun build src/worker/index.ts --target=node --format=esm --outfile=.output/server/worker.mjs",
    "build:vendor": "mkdir -p .output/server/node_modules && cp -RL node_modules/ws .output/server/node_modules/ws && cp -RL node_modules/undici .output/server/node_modules/undici",
    "build:node": "bash infra/fetch-node.sh",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "format": "oxfmt && oxlint --fix && bun run typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:seed": "bun run src/db/seed.ts",
    "db:smoke": "bun run src/db/smoke.ts",
    "worker": "bun run src/worker/index.ts",
    "scrape:once": "bun run src/scripts/scrape-once.ts",
    "poll:once": "bun run src/scripts/poll-once.ts",
    "smoke:verify": "bun run src/scripts/smoke-verify.ts"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@libsql/client": "0.17.3",
    "@tailwindcss/vite": "4.2.4",
    "@tanstack/react-router": "1.168.24",
    "@tanstack/react-router-ssr-query": "1.166.11",
    "@tanstack/react-start": "1.167.48",
    "@tanstack/router-plugin": "1.167.26",
    "cheerio": "1.2.0",
    "croner": "10.0.1",
    "drizzle-orm": "0.45.2",
    "nitro": "3.0.260415-beta",
    "posthog-js": "^1.372.5",
    "posthog-node": "^5.30.6",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "recharts": "3.8.1",
    "tailwindcss": "4.2.4",
    "ws": "8.20.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "0.6.0",
    "@tanstack/react-devtools": "0.10.2",
    "@tanstack/react-router-devtools": "1.166.13",
    "@types/node": "22.19.17",
    "@types/react": "19.2.14",
    "@typescript/native-preview": "7.0.0-dev.20260428.1",
    "@vitejs/plugin-react": "6.0.1",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.46.0",
    "oxlint": "1.61.0",
    "vite": "8.0.10",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
